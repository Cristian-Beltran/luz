# Puerto del servidor
PORT=3000

# Base de datos SQLite
SQLITE_PATH=data/luz.sqlite

# JWT Secret para autenticación (cambiar en producción)
JWT_SECRET=cambia-este-secret-en-produccion-usa-un-string-largo-y-aleatorio

# API Key (si se usa)
API_KEY=

# OpenAI API Key para insights clínicos
OPENAI_API_KEY=

# WhatsApp
WHATSAPP_DEFAULT_COUNTRY_CODE=57

# MQTT Broker (TCP directo para backend local)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=device
MQTT_PASSWORD=esp32

# CORS - dominios permitidos (separados por coma)
CORS_ORIGINS=https://tu-app.netlify.app,http://localhost:5173,http://localhost:4173

# Migration Secret para endpoint /admin-db/migrate
MIGRATION_SECRET=cambia-este-migration-secret
